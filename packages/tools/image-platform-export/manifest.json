  "icon": "📦",
  "version": "1.0.0",
  "runtime": { "client": true, "server": false, "offline": true, "downloadable": true },
  "input": { "accept": ["image/jpeg", "image/png", "image/webp"], "maxSize": "50MB", "batch": true },
  "output": { "formats": ["zip"] },
