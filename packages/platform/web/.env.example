# Local development uses SQLite. This file is safe as a template; do not commit real .env secrets.
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-in-production
PACKY_API_KEY=
PACKY_IMAGE_MODEL=gpt-image-2
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_TEXT_MODEL=mimo-v2.5-pro

# Server deployment note:
# The current Prisma schema datasource provider is sqlite for local debugging.
# For MySQL deployment, switch prisma/schema.prisma datasource provider to "mysql"
# and set DATABASE_URL to your MySQL connection string in the server environment.
